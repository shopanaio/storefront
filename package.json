{
  "name": "@shopana/storefront-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "runtime:init": "yarn workspace @shopana/brand-bite-crunch runtime:init",
    "dev": "yarn workspace @shopana/brand-bite-crunch dev",
    "build": "yarn workspace @shopana/brand-bite-crunch build",
    "start": "yarn workspace @shopana/brand-bite-crunch start",
    "codegen": "yarn workspace @shopana/brand-bite-crunch codegen",
    "widgets:build": "yarn workspace @shopana/brand-bite-crunch widgets:build",
    "widgets:watch": "yarn workspace @shopana/brand-bite-crunch widgets:watch",
    "storybook": "yarn workspace @shopana/brand-bite-crunch storybook",
    "build-storybook": "yarn workspace @shopana/brand-bite-crunch build-storybook",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@atlaskit/eslint-plugin-design-system": "^13.27.0",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@types/node": "^24.10.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "eslint-plugin-css": "^0.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "graphql": "^16.10.0",
    "prettier": "^3.7.1",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@types/react": "19.2.2"
  }
}
