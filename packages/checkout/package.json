{
  "name": "@shopana/checkout",
  "version": "0.1.0",
  "description": "Checkout flow and registration API for Shopana storefront themes.",
  "keywords": [
    "shopana",
    "storefront",
    "checkout",
    "react",
    "nextjs"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/shopanaio/storefront/tree/main/packages/checkout#readme",
  "bugs": {
    "url": "https://github.com/shopanaio/storefront/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopanaio/storefront.git",
    "directory": "packages/checkout"
  },
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "imports": {
    "#checkout/*": {
      "types": "./src/*.js",
      "default": "./src/*"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist --alias \"#checkout/=dist\"",
    "prepack": "yarn build",
    "clean": "rimraf dist",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@apollo/client": "^4.0.0",
    "@shopana/storefront": "^0.1.0",
    "@shopana/storefront-auth": "^0.1.0",
    "@shopana/storefront-sdk": "^0.1.0",
    "@shopana/storefront-ui": "^0.1.0",
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "emittery": "^1.2.0",
    "lodash": "^4.17.21",
    "nprogress": "^0.2.0",
    "react-hook-form": "^7.56.2",
    "react-icons": "^5.5.0",
    "react-use": "^17.6.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@shopana/storefront-auth": "0.1.0",
    "@shopana/storefront-ui": "0.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/lodash": "^4.17.20",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "jsdom": "^26.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
