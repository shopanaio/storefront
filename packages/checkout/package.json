{
  "name": "@shopana/checkout",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#checkout/*": {
      "types": "./src/*.js",
      "default": "./src/*"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@apollo/client": "^4.0.0",
    "@shopana/storefront": "^0.1.0",
    "@shopana/storefront-auth": "^0.1.0",
    "@shopana/storefront-sdk": "^0.1.0",
    "@shopana/storefront-ui": "^0.1.0",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.2.2",
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "clsx": "^2.1.1",
    "emittery": "^1.2.0",
    "lodash": "^4.17.21",
    "nprogress": "^0.2.0",
    "react-hook-form": "^7.56.2",
    "react-icons": "^5.5.0",
    "react-use": "^17.6.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@shopana/storefront-auth": "0.1.0",
    "@shopana/storefront-ui": "0.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.5"
  }
}
