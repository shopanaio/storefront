{
  "name": "@shopana/storefront-modal-stack",
  "version": "0.1.0",
  "description": "Stack of full-screen antd modals with a URL projection for Shopana storefront themes.",
  "keywords": [
    "shopana",
    "storefront",
    "modal",
    "react",
    "antd"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/shopanaio/storefront/tree/main/packages/storefront-modal-stack#readme",
  "bugs": {
    "url": "https://github.com/shopanaio/storefront/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopanaio/storefront.git",
    "directory": "packages/storefront-modal-stack"
  },
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist",
    "prepack": "yarn build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@shopana/storefront": "^0.1.0",
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "qs": "^6.14.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@shopana/storefront": "0.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.14.1",
    "@types/qs": "^6.14.0",
    "@types/react": "19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "jsdom": "^26.0.0",
    "next-intl": "^4.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
