{
  "name": "@shopana/brand-sdk",
  "version": "0.1.0",
  "description": "Theme contract shared by Shopana storefront themes.",
  "keywords": [
    "shopana",
    "storefront",
    "theme"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/shopanaio/storefront/tree/main/packages/brand-sdk#readme",
  "bugs": {
    "url": "https://github.com/shopanaio/storefront/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopanaio/storefront.git",
    "directory": "packages/brand-sdk"
  },
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-imports.mjs dist",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
