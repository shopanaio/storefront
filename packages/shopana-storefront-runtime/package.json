{
  "name": "@shopana/storefront",
  "version": "0.1.0",
  "description": "Next.js and React Router runtimes and framework facades for Shopana storefront themes.",
  "keywords": [
    "shopana",
    "storefront",
    "nextjs",
    "react-router",
    "runtime"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/shopanaio/storefront/tree/main/packages/shopana-storefront-runtime#readme",
  "bugs": {
    "url": "https://github.com/shopanaio/storefront/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopanaio/storefront.git",
    "directory": "packages/shopana-storefront-runtime"
  },
  "private": false,
  "type": "module",
  "files": [
    "bin",
    "dist",
    "src/init.js",
    "src/init.d.ts",
    "templates"
  ],
  "bin": {
    "storefront-runtime": "./bin/storefront-runtime.js"
  },
  "exports": {
    ".": {
      "types": "./src/init.d.ts",
      "import": "./src/init.js",
      "default": "./src/init.js"
    },
    "./link": {
      "types": "./dist/contract/link.d.ts",
      "react-router": "./dist/react-router/link.js",
      "default": "./dist/next/link.js"
    },
    "./navigation": {
      "types": "./dist/contract/navigation.d.ts",
      "react-router": "./dist/react-router/navigation.js",
      "default": "./dist/next/navigation.js"
    },
    "./image": {
      "types": "./dist/contract/image.d.ts",
      "react-router": "./dist/react-router/image.js",
      "default": "./dist/next/image.js"
    },
    "./dynamic": {
      "types": "./dist/contract/dynamic.d.ts",
      "react-router": "./dist/react-router/dynamic.js",
      "default": "./dist/next/dynamic.js"
    },
    "./headers": {
      "types": "./dist/contract/headers.d.ts",
      "react-router": "./dist/react-router/headers.js",
      "default": "./dist/next/headers.js"
    },
    "./page-client": {
      "types": "./dist/contract/page-client.d.ts",
      "react-router": "./dist/react-router/page-client.js",
      "default": "./dist/next/page-client.js"
    },
    "./page-definition": {
      "types": "./dist/core/page-definition.d.ts",
      "default": "./dist/core/page-definition.js"
    },
    "./next/auth": {
      "types": "./dist/next/auth.d.ts",
      "default": "./dist/next/auth.js"
    },
    "./next/auth-headless": {
      "types": "./dist/next/auth-headless.d.ts",
      "default": "./dist/next/auth-headless.js"
    },
    "./next/layout": {
      "types": "./dist/next/layout.d.ts",
      "default": "./dist/next/layout.js"
    },
    "./next/middleware": {
      "types": "./dist/next/middleware.d.ts",
      "default": "./dist/next/middleware.js"
    },
    "./next/not-found": {
      "types": "./dist/next/not-found.d.ts",
      "default": "./dist/next/not-found.js"
    },
    "./next/page": {
      "types": "./dist/next/page.d.ts",
      "default": "./dist/next/page.js"
    },
    "./react-router/app": {
      "types": "./dist/react-router/app.d.ts",
      "default": "./dist/react-router/app.js"
    },
    "./react-router/auth": {
      "types": "./dist/react-router/auth.d.ts",
      "default": "./dist/react-router/auth.js"
    },
    "./react-router/auth-headless": {
      "types": "./dist/react-router/auth-headless.d.ts",
      "default": "./dist/react-router/auth-headless.js"
    },
    "./react-router/document": {
      "types": "./dist/react-router/document.d.ts",
      "default": "./dist/react-router/document.js"
    },
    "./react-router/entry.server": {
      "types": "./dist/react-router/entry.server.d.ts",
      "default": "./dist/react-router/entry.server.js"
    },
    "./react-router/page": {
      "types": "./dist/react-router/page.d.ts",
      "default": "./dist/react-router/page.js"
    },
    "./react-router/root": {
      "types": "./dist/react-router/root.d.ts",
      "default": "./dist/react-router/root.js"
    },
    "./react-router/server": {
      "types": "./dist/react-router/server.d.ts",
      "default": "./dist/react-router/server.js"
    },
    "./react-router/vite": {
      "types": "./dist/react-router/vite.d.ts",
      "default": "./dist/react-router/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.contract.json && node ../../scripts/fix-esm-imports.mjs dist",
    "prepack": "yarn build",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "isbot": "^5.1.40"
  },
  "peerDependencies": {
    "@apollo/client": "^4.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@shopana/storefront-auth": "^0.1.0",
    "@shopana/storefront-sdk": "^0.1.0",
    "next": "^16.0.5",
    "next-intl": "^4.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.1",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@react-router/dev": {
      "optional": true
    },
    "@react-router/node": {
      "optional": true
    },
    "@react-router/serve": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "next-intl": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@types/node": "^24.10.1",
    "@types/webpack-env": "^1.18.8",
    "next": "16.0.5",
    "react-router": "8.5.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "7.2.4",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
