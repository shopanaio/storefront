{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "src/pwa.ts",
    "src/seo.ts",
    "src/core/**/*.ts",
    "src/core/**/*.tsx",
    "src/next/**/*.ts",
    "src/next/**/*.tsx",
    "src/react-router/**/*.ts",
    "src/react-router/**/*.tsx",
    "src/static/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.types.ts"]
}
