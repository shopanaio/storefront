{
  "name": "@shopana/storefront-ui",
  "version": "0.1.0",
  "description": "Form and overlay primitives shared by Shopana storefront packages.",
  "keywords": [
    "shopana",
    "storefront",
    "ui",
    "react",
    "antd"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/shopanaio/storefront/tree/main/packages/storefront-ui#readme",
  "bugs": {
    "url": "https://github.com/shopanaio/storefront/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopanaio/storefront.git",
    "directory": "packages/storefront-ui"
  },
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "default": "./dist/phone/index.js"
    },
    "./drawer": {
      "types": "./dist/drawer/index.d.ts",
      "default": "./dist/drawer/index.js"
    },
    "./banner": {
      "types": "./dist/banner/index.d.ts",
      "default": "./dist/banner/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "prepack": "yarn build",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-animate-height": "^3.2.3",
    "react-icons": "^5.5.0",
    "react-phone-number-input": "^3.4.14",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.14.1",
    "@types/react": "19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "jsdom": "^26.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
